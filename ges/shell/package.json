{
  "name": "ges",
  "productName": "GES",
  "version": "1.0.3",
  "description": "GES - GESMAR, GESTIME, GESTAT et GESCOUNT dans un seul programme",
  "author": "fabz91",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "24.13.3",
    "rcedit": "3.1.0"
  },
  "build": {
    "appId": "fr.fabz91.ges",
    "productName": "GES",
    "copyright": "fabz91",
    "directories": { "output": "dist" },
    "files": ["main.js", "switcher.js", "config.js", "icon.png", "icon.ico", "package.json", "apps/**"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "icon.ico",
      "artifactName": "GES-Installateur-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "language": "1036",
      "include": "installer.nsh"
    },
    "extraResources": [{ "from": "icon.ico", "to": "ges-icone.ico" }],
    "afterPack": "./afterpack.js"
  }
}
